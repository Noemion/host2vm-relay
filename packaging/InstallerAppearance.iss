; Use a modest 105% window size instead of Inno's default 120% enlargement.
; Native DPI scaling remains enabled for text and controls.
[Setup]
WizardStyle=modern
WizardSizePercent=105

[LangOptions]
zhcn.DialogFontName=Microsoft YaHei UI
zhcn.DialogFontSize=9
en.DialogFontName=Segoe UI
en.DialogFontSize=9
